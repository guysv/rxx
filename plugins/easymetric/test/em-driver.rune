// Test driver: fills rectangles into the active view as *recorded* edits
// replay can author the three silhouettes without mouse-coordinate
// fragility.
//
// t/fill <x1> <y1> <x2> <y2> <color> — fill a rect of the active view
// (y-up dst coords, like a selection). Fills queue on the command and run
// in the next shade; touch_view at command time re-records the view so
// view_pixels (and the carve's snapshot probes) see them a frame later.
pub fn init(rx) {
    // The easymetric package is staged beside this driver; reuse its
    // shader for the plain textured blit.
    let wgsl = rx.read_file("easymetric/easymetric.wgsl").unwrap();
    let shader = rx.create_shader(wgsl).unwrap();
    let show = rx.create_render_pipeline(shader, "vs_quad", "fs_show", 1).unwrap();
    rx.register_command("t/fill", ["int", "int", "int", "int", "color"], "Fill a rect (test driver)", fill);
    #{ show, queue: [] }
}

pub fn fill(state, rx, args) {
    let id = rx.active_view_id();
    state.queue.push((id, args[0], args[1], args[2], args[3], args[4]));
    rx.touch_view(id);
}

pub fn shade(state, rx, encoder) {
    if state.queue.len() == 0 {
        return;
    }
    for job in state.queue {
        let (id, x1, y1, x2, y2, color) = job;
        let view = None;
        for v in rx.views() {
            if v.id == id {
                view = Some(v);
            }
        }
        if view.is_none() {
            continue;
        }
        let view = view.unwrap();
        // begin_view_pass writes the *raw sheet* (not routed): target the
        // active layer's strip by offsetting dst y by active_layer*fh and
        // sizing the ortho to the full sheet (fh*nlayers).
        let fh = view.frame_height;
        let sheet_h = fh * view.nlayers;
        let off = view.active_layer * fh;
        let tex = rx.create_texture(1, 1).unwrap();
        tex.fill(color);
        let tbg = rx.create_transform_bind_group(view.width, sheet_h, rx::mat4_identity()).unwrap();
        let sbg = rx.create_texture_bind_group(tex).unwrap();
        let v = rx.create_sprite_vertices(tex, #{
            dst: rx::rect(x1 as f64, (y1 + off) as f64, x2 as f64, (y2 + off) as f64),
        }).unwrap();
        let pass = encoder.begin_view_pass("t-fill", id, "load").unwrap();
        pass.set_pipeline(state.show).unwrap();
        pass.set_bind_group(0, tbg).unwrap();
        pass.set_bind_group(1, sbg).unwrap();
        pass.set_vertex_buffer(0, v).unwrap();
        pass.draw(v.count(), 1).unwrap();
        pass.end();
    }
    state.queue = [];
}
