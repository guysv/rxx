// Fixture plugin: a custom script mode. `:funky` enters the mode, the
// draw hook makes the mode digest-visible, escape exits it (builtin
// catch-all — that's what the replay proves).
pub fn init(rx) {
    rx.register_command("funky", [], "Enter funky mode", funky);
    #{}
}

pub fn funky(state, rx, args) {
    rx.switch_mode("funky");
}

pub fn draw(state, rx) {
    if rx.mode() == "funky" {
        let (_, height) = rx.screen_size();
        let text_y = (height as f64) - 46.0 - 14.0;
        rx.draw_text("-- FUNKY --", 10.0, text_y, rx::rgb(0, 255, 0));
    }
}
